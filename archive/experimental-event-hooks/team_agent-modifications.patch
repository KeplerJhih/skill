diff --git a/hooks/notify-notification.sh b/hooks/notify-notification.sh
index 1df1ba8..0ad33d0 100755
--- a/hooks/notify-notification.sh
+++ b/hooks/notify-notification.sh
@@ -1,6 +1,8 @@
 #!/bin/bash
 # Hook: Notification event — Claude 等待用戶回應時觸發
 # stdin 接收 JSON，解析後動態產生通知訊息
+#
+# 在原本的 terminal-notifier 行為之後，額外將事件 POST 給 team-agent backend。
 
 INPUT=$(cat)
 MESSAGE=$(echo "$INPUT" | jq -r '.notification_message // empty')
@@ -10,4 +12,11 @@ if [ -z "$MESSAGE" ]; then
 fi
 
 terminal-notifier -title "Claude" -message "$MESSAGE" -sound default
+
+# Forward to team-agent backend (best-effort, never blocks).
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=event-base.sh
+source "$DIR/event-base.sh"
+printf '%s' "$INPUT" | post_event "notification"
+
 exit 0
